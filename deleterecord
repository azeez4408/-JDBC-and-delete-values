import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;

public class DeleteRecord {

    public static void main(String[] args) {

        // Database details
        String url = "jdbc:mysql://localhost:3306/college";
        String username = "root";
        String password = "your_password";

        // SQL query to delete a student
        String sql = "DELETE FROM students WHERE id = ?";

        try {
            // Establish database connection
            Connection con = DriverManager.getConnection(
                    url, username, password
            );

            System.out.println("Database connected successfully!");

            // Create PreparedStatement
            PreparedStatement ps = con.prepareStatement(sql);

            // Set the ID of the record to delete
            ps.setInt(1, 2);

            // Execute delete operation
            int rows = ps.executeUpdate();

            if (rows > 0) {
                System.out.println("Record deleted successfully.");
            } else {
                System.out.println("Record not found.");
            }

            // Close resources
            ps.close();
            con.close();

        } catch (Exception e) {
            System.out.println("Error occurred while deleting record.");
            e.printStackTrace();
        }
    }
}

Example table

Suppose the students table contains:

CREATE DATABASE college;

USE college;

CREATE TABLE students (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    course VARCHAR(50)
);

INSERT INTO students VALUES
(1, 'Rahul', 'Java'),
(2, 'Priya', 'Python'),
(3, 'Arun', 'Database');


The Java statement:

ps.setInt(1, 2);


sets the ID to 2, so the SQL query:

DELETE FROM students WHERE id = 2;


deletes the Priya record.

Important JDBC methods

DriverManager.getConnection() — connects Java to the database.

prepareStatement() — creates a parameterized SQL statement.

setInt() — supplies the value for ?.

executeUpdate() — executes DELETE, INSERT, or UPDATE statements.

close() — closes the JDBC resources.

Using PreparedStatement is preferable to constructing the SQL query by concatenating user input, because it helps prevent SQL injection.
